    "retain_frozen_winding_index_exact": true,
    "snapshot_restore_rule_unchanged": true
  },
  "future_pb3_live_pair_revalidation": {
    "history_samples": 3,
    "source": "original_pb2c_pair_admission_semantics",
    "require_same_time": true,
    "require_common_action_history_equal": true,
    "require_nonempty_visible_rope_each_frame": true,
    "require_live_winding_index_different": true,
    "require_all_10_formal_pairs": true,
    "allow_pair_drop": false,
    "allow_pair_replacement": false,
